{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "login": {
        "ClusterId": "user-service",
        "Order": -1,
        "RateLimiterPolicy": "login",
        "Match": {
          "Path": "/api/users/login",
          "Methods": [
            "POST"
          ]
        }
      },
      "users": {
        "ClusterId": "user-service",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "incidents": {
        "ClusterId": "incident-service",
        "Match": {
          "Path": "/api/incidents/{**catch-all}"
        }
      },
      "notifications": {
        "ClusterId": "notification-service",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "notification-hub": {
        "ClusterId": "notification-service",
        "Match": {
          "Path": "/hubs/notifications/{**catch-all}"
        }
      },
      "monitoring": {
        "ClusterId": "monitoring-service",
        "Match": {
          "Path": "/api/monitoring/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-service": {
        "Destinations": {
          "primary": {
            "Address": "http://user-service:8080/"
          }
        }
      },
      "incident-service": {
        "Destinations": {
          "primary": {
            "Address": "http://incident-service:8080/"
          }
        }
      },
      "notification-service": {
        "Destinations": {
          "primary": {
            "Address": "http://notification-service:8080/"
          }
        }
      },
      "monitoring-service": {
        "Destinations": {
          "primary": {
            "Address": "http://monitoring-service:8080/"
          }
        }
      }
    }
  }
}
