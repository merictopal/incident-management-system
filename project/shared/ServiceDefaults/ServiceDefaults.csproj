<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Cross-cutting building blocks shared by all backend services:
    JWT authentication setup, internal API-key protection, health endpoint
    and the message contracts exchanged between services.
    No business logic lives here.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.8" />
  </ItemGroup>
</Project>
